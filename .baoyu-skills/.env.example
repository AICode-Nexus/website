# Project-level config for baoyu skills.
# Copy this file to .baoyu-skills/.env and fill only the providers you use.
# Load priority from baoyu-skills docs:
# 1. CLI-prefixed env vars
# 2. System env vars
# 3. ./.baoyu-skills/.env
# 4. ~/.baoyu-skills/.env

# OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview

# DashScope (Qwen)
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro

# Replicate
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=google/nano-banana-pro

# Jimeng
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
JIMENG_IMAGE_MODEL=jimeng_t2i_v40

# Seedream / Volcengine ARK
ARK_API_KEY=
SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-260128

# WeChat Official Account publishing
WECHAT_APP_ID=
WECHAT_APP_SECRET=
